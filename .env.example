# Copy to .env and adjust. Never commit .env.

# development | production
DJANGO_ENV=development

# Lab: leave unset to use the insecure development fallback in development.py
# Production: REQUIRED — generate with:
#   py -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Lab default True. Ignored when DJANGO_ENV=production (DEBUG is always False there).
DJANGO_DEBUG=True

# Comma-separated hosts (no spaces required)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated origins including scheme + port
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional: add LAN IP when testing from another device, e.g.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.149.185.138
# DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://10.149.185.138:8000

# --- Database ---
# Lab default: SQLite (no vars needed).
# Production: MySQL / Postgres, or SQLite only with DJANGO_ALLOW_SQLITE=True (PA free).
# DJANGO_ALLOW_SQLITE=False
#
# PythonAnywhere MySQL example:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=YOURUSERNAME$madrasa
# DB_USER=YOURUSERNAME
# DB_PASSWORD=your-mysql-password
# DB_HOST=YOURUSERNAME.mysql.pythonanywhere-services.com
# DB_PORT=3306
#
# VPS Postgres example:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=madrasa
# DB_USER=madrasa
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
#
# Or URL (overrides discrete vars):
# DATABASE_URL=mysql://USER:PASS@HOST:3306/DBNAME
# DATABASE_URL=postgres://madrasa:change-me@127.0.0.1:5432/madrasa

# Production HTTPS helpers (used when DJANGO_ENV=production)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# DRF /api-token-auth/ — OFF by default. Enable only for lab/mobile experiments.
# Do not enable on a public production host without a real API + hardening.
# DJANGO_ENABLE_TOKEN_AUTH=False

