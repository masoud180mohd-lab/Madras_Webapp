# Copy to .env and adjust. Never commit .env.

# development | production
DJANGO_ENV=development

# Lab: leave unset to use the insecure development fallback in development.py
# Production: REQUIRED — generate with:
#   py -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Lab default True. Ignored when DJANGO_ENV=production (DEBUG is always False there).
DJANGO_DEBUG=True

# Comma-separated hosts (no spaces required)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated origins including scheme + port
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional: add LAN IP when testing from another device, e.g.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.149.185.138
# DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://10.149.185.138:8000

# SQLite is the lab default (see settings). Uncomment only if you change DB later.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=

# Production HTTPS helpers (used when DJANGO_ENV=production)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# DRF /api-token-auth/ — OFF by default. Enable only for lab/mobile experiments.
# Do not enable on a public production host without a real API + hardening.
# DJANGO_ENABLE_TOKEN_AUTH=False

