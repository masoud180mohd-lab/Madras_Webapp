# Nakili faili hii → deploy/pythonanywhere/secrets.env
# USIWEKE secrets.env kwenye git / chat.

PA_USERNAME=rasulillahmadras
PA_HOST=www.pythonanywhere.com
PA_API_TOKEN=bandika-token-hapa

# MySQL kutoka Databases tab (jina la DB kawaida: rasulillahmadras$madrasa)
DB_PASSWORD=bandika-mysql-password-hapa
DB_NAME=rasulillahmadras$madrasa
DB_USER=rasulillahmadras
DB_HOST=rasulillahmadras.mysql.pythonanywhere-services.com

# Path ya mradi kwenye PA (badilisha ikiwa folder ina jina tofauti)
PA_PROJECT_HOME=/home/rasulillahmadras/Madras_Webapp
PA_DOMAIN=rasulillahmadras.pythonanywhere.com
